{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/donaldte/cameroonian-language-ai/data/schemas/text-record.schema.json",
  "title": "CLA-Data v0.1 Text Record",
  "description": "Schema for a single text record in a CLA-Data dataset. See docs/cla-data-schema.md for the full specification.",
  "type": "object",
  "required": [
    "id",
    "language",
    "text",
    "source",
    "license",
    "consent_version",
    "contributor_id",
    "validated",
    "validated_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cla_(fub|ewo|bbj)_[0-9a-fA-F-]{36}$"
    },
    "language": {
      "type": "string",
      "enum": ["fub", "ewo", "bbj"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "translation_fr": {
      "type": ["string", "null"]
    },
    "translation_en": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "string",
      "enum": ["original", "elicited", "translated_from_existing", "public_domain_text", "institutional_partner"]
    },
    "license": {
      "type": "string",
      "enum": ["CC-BY-4.0", "CC-BY-NC-4.0"]
    },
    "consent_version": {
      "type": "string",
      "description": "Either the individual-contributor consent policy version (e.g. 'v1.0'), or a reference to a documented partner agreement (e.g. 'partner:abc-2026-09') for institutional_partner records."
    },
    "contributor_id": {
      "type": ["string", "null"]
    },
    "source_organization": {
      "type": ["string", "null"],
      "description": "Name of the institutional partner this record came from, required when source is institutional_partner, null otherwise."
    },
    "speaker_id": {
      "type": ["string", "null"]
    },
    "validated": {
      "type": "boolean"
    },
    "validated_by": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    { "required": ["translation_fr"] },
    { "required": ["translation_en"] }
  ],
  "additionalProperties": false
}

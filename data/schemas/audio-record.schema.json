{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/donaldte/cameroonian-language-ai/data/schemas/audio-record.schema.json",
  "title": "CLA-Data v0.1 Audio Record",
  "description": "Schema for a single audio record in a CLA-Data dataset. See docs/cla-data-schema.md for the full specification.",
  "type": "object",
  "required": [
    "id",
    "language",
    "audio_path",
    "transcription",
    "duration_sec",
    "sample_rate",
    "source",
    "license",
    "consent_version",
    "contributor_id",
    "validated",
    "validated_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cla_(fub|ewo|bbj)_[0-9a-fA-F-]{36}$"
    },
    "language": {
      "type": "string",
      "enum": ["fub", "ewo", "bbj"]
    },
    "audio_path": {
      "type": "string",
      "pattern": "^speech/.+\\.wav$"
    },
    "transcription": {
      "type": "string",
      "minLength": 1
    },
    "translation_fr": {
      "type": ["string", "null"]
    },
    "translation_en": {
      "type": ["string", "null"]
    },
    "duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sample_rate": {
      "type": "integer",
      "const": 16000
    },
    "source": {
      "type": "string",
      "enum": ["read_speech", "spontaneous", "elicited", "institutional_partner", "existing_dataset"]
    },
    "license": {
      "type": "string",
      "enum": ["CC-BY-4.0", "CC-BY-NC-4.0", "Apache-2.0"]
    },
    "consent_version": {
      "type": "string",
      "description": "One of: the individual-contributor consent policy version (e.g. 'v1.0'); a documented partner agreement reference (e.g. 'partner:grn-2026-09') for institutional_partner records; or 'dataset:<hf-dataset-id>' for existing_dataset records, where the dataset's own published license is the operative permission (no CLA consent process applies)."
    },
    "contributor_id": {
      "type": ["string", "null"]
    },
    "source_organization": {
      "type": ["string", "null"],
      "description": "For institutional_partner: the partner's name. For existing_dataset: the dataset's identifier. Null otherwise."
    },
    "speaker_id": {
      "type": ["string", "null"]
    },
    "speaker_demographics": {
      "type": ["object", "null"],
      "properties": {
        "age_range": { "type": ["string", "null"] },
        "gender": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "validated": {
      "type": "boolean"
    },
    "validated_by": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    { "required": ["translation_fr"] },
    { "required": ["translation_en"] }
  ],
  "additionalProperties": false
}
